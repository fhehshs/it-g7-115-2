[{"id": 1, "title": "夢想電腦 Dream PC 試算表", "chapter": "封面", "bg": "navy", "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>🖥️</div>\n  <h1 style='font-size:2.6rem;font-weight:900;color:#fff;margin-bottom:10px;'>夢想電腦 Dream PC</h1>\n  <h2 style='font-size:1.25rem;font-weight:400;color:#93c5fd;margin-bottom:24px;'>Dream PC Builder · Data Processing with Google Sheets</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;'><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🎯 依用途選規格</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>📊 Google 試算表</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>➕ SUM 函數</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>💰 預算 30,000</span></div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>七年級第二學期 ｜ 第 5 週</p>\n</div>\n", "quiz": null, "chart": null, "video": null}, {"id": 2, "title": "用途決定規格", "chapter": "第一節：選電腦要看什麼", "bg": "white", "html": "<h2 class='slide-title'>🎯 先問用途，再挑規格</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;'><strong style='color:#1e40af;font-size:.9rem;'>📚 學習、上網、文書</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>重點：<strong>CPU ＋ RAM</strong><br>中階 CPU、RAM 8–16 GB 就很夠用；不一定需要獨立顯示卡</div></div><div style='background:#fef2f2;padding:14px;border-radius:10px;'><strong style='color:#991b1b;font-size:.9rem;'>🎮 玩大型遊戲</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>重點：<strong>GPU ＋ CPU</strong><br>顯示卡決定畫面流不流暢；螢幕更新率（Hz）也很重要</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><strong style='color:#166534;font-size:.9rem;'>✂️ 剪輯影片、做 3D</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>重點：<strong>RAM ＋ SSD ＋ CPU</strong><br>RAM 16 GB 以上、大容量 SSD，多核心 CPU 輸出影片更快</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 💬 沒有「最好」的電腦，只有「<strong>最適合你用途和預算</strong>」的電腦。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 3, "title": "看懂規格表", "chapter": "第一節：選電腦要看什麼", "bg": "white", "html": "<h2 class='slide-title'>🔍 看懂規格表：把前幾週學的串起來</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:22%;'>規格</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:28%;'>對應第幾週學的</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:50%;'>怎麼看</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>處理器 CPU</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>第 2–3 週</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>核心數、時脈、世代；有 NPU 代表支援本機 AI 功能</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>記憶體 RAM</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>第 3 週</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>GB 越大可同時開越多程式</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>儲存 SSD／HDD</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>第 3–4 週</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>容量（GB／TB）與速度；SSD 比 HDD 快</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>顯示卡 GPU</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>第 2 週</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>遊戲、剪輯、AI 運算需要</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>螢幕</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>第 4 週（輸出設備）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>尺寸（吋）、解析度、更新率（Hz）</td></tr></table>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 🧠 你已經學會看規格了！這週要把這些知識變成<strong>資料</strong>，用試算表幫你做決定。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 4, "title": "桌機、筆電、平板比一比", "chapter": "第一節：選電腦要看什麼", "bg": "white", "html": "<h2 class='slide-title'>⚖️ 桌機、筆電、平板比一比</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:16%;'></th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:28%;'>桌上型電腦</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:28%;'>筆記型電腦</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:28%;'>平板／Chromebook</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>效能</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>同價位通常最強</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>中到高</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>較輕量</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>攜帶</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>不能帶著走</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>可攜帶</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>最輕便</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>升級</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>可自己換零件</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>部分可升級</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>幾乎不能</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>適合</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>遊戲、剪輯、長時間使用</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>上學、出差、多用途</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>上網、看影片、線上學習</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🏪 台灣小知識：台北的<strong>光華商場</strong>一帶有很多電腦零件店，很多人會在這裡比價、組裝自己的桌機。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 5, "title": "第一節 隨堂測驗", "chapter": "第一節：選電腦要看什麼", "bg": "purple", "quiz": "q1", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>依用途選規格 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 6, "title": "認識試算表", "chapter": "第二節：Google 試算表基本功", "bg": "white", "html": "<h2 class='slide-title'>📊 認識 Google 試算表</h2>\n<div style='display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>⬇️</div><strong style='color:#1e40af;font-size:.9rem;'>欄 Column</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>直的，用<strong>英文字母</strong>命名：A、B、C…</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>➡️</div><strong style='color:#166534;font-size:.9rem;'>列 Row</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>橫的，用<strong>數字</strong>命名：1、2、3…</div></div><div style='background:#fefce8;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🔲</div><strong style='color:#854d0e;font-size:.9rem;'>儲存格 Cell</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>欄和列交叉的格子，一格放一筆資料</div></div><div style='background:#f5f3ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>📍</div><strong style='color:#5b21b6;font-size:.9rem;'>位址</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>欄＋列，例如 <strong>B3</strong>＝B 欄第 3 列</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🔗 開啟方式：登入學校 Google 帳號 → Google 雲端硬碟 → 新增 → Google 試算表。可以和同學<strong>即時共編</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 7, "title": "輸入資料與格式", "chapter": "第二節：Google 試算表基本功", "bg": "white", "html": "<h2 class='slide-title'>⌨️ 輸入資料：一格一筆、一欄一種</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:8%;'></th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:14%;'>A</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:26%;'>B</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:26%;'>C</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:26%;'>D</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>編號</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>零件</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>規格</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>價格</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>2</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>CPU</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>6 核心中階</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>6,500</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>3</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>2</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>主機板</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>相容 CPU</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>3,500</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>4</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>3</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>記憶體 RAM</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>16 GB</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>2,000</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>5</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>4</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>SSD</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1 TB</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>2,200</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>6</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>5</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>顯示卡</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>中階</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>10,000</td></tr></table>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> ✅ 好習慣：第 1 列放<strong>標題</strong>（零件、規格、價格）；價格欄只放<strong>數字</strong>，不要打「元」字，要顯示貨幣就用「格式 → 數值 → 貨幣」。<br>⚠️ 上表價格為<strong>教學示範用數字</strong>，不是實際報價。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 8, "title": "公式與函數", "chapter": "第二節：Google 試算表基本功", "bg": "white", "html": "<h2 class='slide-title'>➕ 公式與函數：讓試算表幫你算</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #2563eb;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>📖 在儲存格先打 <strong>＝</strong>（等號），試算表就知道「這是要計算的」。</p></div>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>寫法</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:34%;'>意思</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:36%;'>範例結果</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>=D2+D3</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>把 D2 和 D3 相加</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>6,500 ＋ 3,500 ＝ 10,000</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>=SUM(D2:D10)</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>把 D2 到 D10 全部加總</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>所有零件總價</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>=AVERAGE(D2:D10)</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>計算平均</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>平均一個零件多少錢</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>=MAX(D2:D10)</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>找最大值</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>最貴的零件價格</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>=MIN(D2:D10)</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>找最小值</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>最便宜的零件價格</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🔑 <strong>D2:D10</strong> 的冒號代表「從 D2 到 D10 這一整段」，叫做<strong>範圍</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 9, "title": "自動填滿", "chapter": "第二節：Google 試算表基本功", "bg": "white", "html": "<h2 class='slide-title'>🪄 自動填滿：不用一格一格打</h2>\n<div style='display:flex;flex-direction:column;gap:8px;margin-bottom:12px;'><div style='display:flex;gap:12px;align-items:flex-start;background:#f0fdf4;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#16a34a;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>1</div><div><strong style='color:#166534;font-size:.88rem;'>選取儲存格</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>點一下已經寫好公式或資料的儲存格</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f0fdf4;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#16a34a;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>2</div><div><strong style='color:#166534;font-size:.88rem;'>找到右下角的小方塊</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>滑鼠移到格子右下角，游標變成十字「＋」</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f0fdf4;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#16a34a;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>3</div><div><strong style='color:#166534;font-size:.88rem;'>往下拖曳</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>拖到要填的位置，試算表會自動延續公式或數列（1、2、3…）</div></div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧠 為什麼公式拖曳後會自動變？例如 E2 寫 <strong>=D2*1.05</strong>，往下拖到 E3 會自動變成 <strong>=D3*1.05</strong>——試算表會依照「相對位置」調整，這叫<strong>相對參照</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 10, "title": "第二節 隨堂測驗", "chapter": "第二節：Google 試算表基本功", "bg": "purple", "quiz": "q2", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>試算表基本功 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 11, "title": "預算檢查", "chapter": "第三節：用資料做決定", "bg": "white", "html": "<h2 class='slide-title'>💰 預算檢查：示範資料超支了嗎？</h2>\n<div style='display:grid;grid-template-columns:1.3fr 1fr;gap:12px;'><table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:12%;'></th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>C</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:58%;'>D</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>11</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>總計</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>32,400</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>12</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>剩餘預算</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>=30000-D11 → -2,400</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>13</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>判斷</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>=IF(D11&lt;=30000,\"預算內\",\"超支\")</td></tr></table>\n<div style='background:#fff7ed;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🤔</div><strong style='color:#9a3412;font-size:.9rem;'>怎麼辦？</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>示範資料的總價 <strong>32,400</strong> 元，超過預算 2,400 元。<br>🔹 顯示卡換便宜一點？<br>🔹 螢幕先用舊的？<br>🔹 如果是「學習用」，可以不買獨立顯示卡！</div></div></div>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 🔀 <strong>IF</strong> 函數會「判斷條件，再決定顯示什麼」——這就是下週開始要學的<strong>演算法</strong>裡的「選擇」概念！</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 12, "title": "排序與篩選", "chapter": "第三節：用資料做決定", "bg": "white", "html": "<h2 class='slide-title'>🔃 排序與篩選：找出重點</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🔃</div><strong style='color:#1e40af;font-size:.9rem;'>排序</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>選取資料範圍 → 資料 → 排序範圍 → 依「價格」由大到小。<br>馬上看出<strong>哪個零件最花錢</strong>。</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🔎</div><strong style='color:#166534;font-size:.9rem;'>篩選</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>資料 → 建立篩選器 → 點標題的篩選圖示，只顯示符合條件的資料，例如「價格大於 3,000」。</div></div></div>\n<div style='background:#fef2f2;padding:11px 16px;border-radius:8px;border-left:4px solid #dc2626;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> ⚠️ 排序前要<strong>選取整個表格</strong>（含零件名稱），不然只排價格欄，零件和價格會對不起來！</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 13, "title": "用圖表看預算分配", "chapter": "第三節：用資料做決定", "bg": "white", "html": "<h2 class='slide-title'>🥧 用圖表看預算分配</h2>\n<div style='display:flex;flex-direction:column;gap:8px;margin-bottom:12px;'><div style='display:flex;gap:12px;align-items:flex-start;background:#f5f3ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#7c3aed;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>1</div><div><strong style='color:#5b21b6;font-size:.88rem;'>選取零件與價格兩欄</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>例如 B1:B10 和 D1:D10（按住 Ctrl 可以選不相鄰的欄）</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f5f3ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#7c3aed;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>2</div><div><strong style='color:#5b21b6;font-size:.88rem;'>插入 → 圖表</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>圖表類型選「圓餅圖」</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f5f3ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#7c3aed;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>3</div><div><strong style='color:#5b21b6;font-size:.88rem;'>加上標題與百分比</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>在圖表編輯器的「自訂」中設定標題、顯示百分比</div></div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 📊 從示範資料的圓餅圖可以看出：顯示卡約占總價的 <strong>三成</strong>（10,000 ÷ 32,400 ≈ 31%）。圓餅圖適合看「<strong>每一部分占整體多少</strong>」。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 14, "title": "比價與資料來源", "chapter": "第三節：用資料做決定", "bg": "white", "html": "<h2 class='slide-title'>🔎 比價與資料來源：數字要可以查證</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>⚖️</div><strong style='color:#1e40af;font-size:.9rem;'>至少比 2 家</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>電腦零件價格常變動，同一個零件比較 2 個以上的報價來源</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>📅</div><strong style='color:#166534;font-size:.9rem;'>記下日期</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>在表格加一欄「查詢日期」，因為價格會隨時間改變</div></div><div style='background:#fefce8;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🔗</div><strong style='color:#854d0e;font-size:.9rem;'>附上網址</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>加一欄「來源網址」，讓別人可以檢查你的資料</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧠 這和上學期學的<strong>資料查證</strong>是同一件事：有來源、有日期、能比對，資料才可信。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 15, "title": "第三節 隨堂測驗", "chapter": "第三節：用資料做決定", "bg": "purple", "quiz": "q3", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>用資料做決定 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 16, "title": "Dream PC 專案任務", "chapter": "Dream PC 專案", "bg": "white", "html": "<h2 class='slide-title'>🖥️ 個人專案：預算 30,000 元的夢想電腦</h2>\n<div style='background:#eff6ff;border-radius:12px;padding:16px;margin-bottom:12px;'><p style='color:#1e40af;font-size:.9rem;font-weight:700;margin-bottom:8px;'>📋 用 Google 試算表完成（含周邊設備）</p><div style='display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px;'><div style='background:#f8fafc;padding:14px;border-radius:10px;'><strong style='color:#334155;font-size:.9rem;'>① 決定用途</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>學習？遊戲？剪輯？寫在表格最上方</div></div><div style='background:#f8fafc;padding:14px;border-radius:10px;'><strong style='color:#334155;font-size:.9rem;'>② 列出零件</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>零件、規格、價格、查詢日期、來源網址 5 欄</div></div><div style='background:#f8fafc;padding:14px;border-radius:10px;'><strong style='color:#334155;font-size:.9rem;'>③ 用函數計算</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>SUM 總價、剩餘預算、IF 判斷是否超支</div></div><div style='background:#f8fafc;padding:14px;border-radius:10px;'><strong style='color:#334155;font-size:.9rem;'>④ 做一張圖表</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>圓餅圖呈現預算分配</div></div></div>\n</div><div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 ✍️ 最後在表格下方寫 3 句話：你的電腦<strong>最大的優點</strong>是什麼？為了守住預算<strong>犧牲了什麼</strong>？為什麼這樣選？</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 17, "title": "評分規準", "chapter": "Dream PC 專案", "bg": "white", "html": "<h2 class='slide-title'>📏 Dream PC 評分規準</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:22%;'>向度</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:20%;'>A</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:20%;'>B</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:19%;'>C</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:19%;'>D</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>規格與用途（30）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>規格完全符合用途，能說明取捨理由</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>規格大致符合用途</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>規格與用途部分不符</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>未說明用途</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>試算表函數（30）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>SUM、剩餘預算、IF 皆正確</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>完成 SUM 與剩餘預算</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>僅完成 SUM</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>未使用函數</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>資料來源（20）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>每項都有日期與網址，且比較 2 家</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>大部分有來源</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>少數有來源</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>沒有來源</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>圖表與說明（20）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>圖表清楚、3 句說明有根據</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>圖表與說明完成</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>缺圖表或說明</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>皆未完成</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 💡 對應課程計畫評量：<strong>A 能應用、分析資料處理的概念與方法</strong>；B 能理解；C 能認識；D 能認識部分。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 18, "title": "本章重點回顧", "chapter": "Dream PC 專案", "bg": "navy", "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 第 5 週 重點回顧</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>依用途選規格</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>學習看 CPU＋RAM、遊戲看 GPU、剪輯看 RAM＋SSD</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>試算表基本</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>欄＝字母、列＝數字、位址如 B3；公式以 ＝ 開頭</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>常用函數</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>SUM 加總、AVERAGE 平均、MAX／MIN 最大最小、IF 判斷</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>資料可信</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>比價 2 家以上、記錄日期與來源；用圖表看比例</p></div></div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>IF 函數「依條件做不同的事」——電腦是怎麼一步一步解決問題的？</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>下一週：演算法是什麼？</p>\n</div>\n", "quiz": null, "chart": null, "video": null}]