[{"id": 1, "title": "Scratch 重複結構與學期總結", "chapter": "封面", "bg": "navy", "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>🔁</div>\n  <h1 style='font-size:2.6rem;font-weight:900;color:#fff;margin-bottom:10px;'>Scratch 重複結構與學期總結</h1>\n  <h2 style='font-size:1.25rem;font-weight:400;color:#93c5fd;margin-bottom:24px;'>Repetition · Loops in Scratch · Semester Review</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;'><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🔁 計次式迴圈</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>✏️ 畫多邊形</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>➕ 1＋2＋…＋N</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🏆 學期回顧</span></div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>七年級第二學期 ｜ 第 14–15 週</p>\n</div>\n", "quiz": null, "chart": null, "video": null}, {"id": 2, "title": "為什麼需要重複結構", "chapter": "第一節：重複結構", "bg": "white", "html": "<h2 class='slide-title'>🤔 還記得走路的貓嗎？</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 14px;margin-bottom:10px;'><div style='font-size:.75rem;color:#64748b;margin-bottom:8px;'>❌ 循序寫法：同樣 3 個積木寫 3 次</div><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#4c97ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>移動 30 點</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#9966ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>換成下一個造型</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffab19;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>等待 0.3 秒</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#4c97ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>移動 30 點</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#9966ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>換成下一個造型</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffab19;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>等待 0.3 秒</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#4c97ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>移動 30 點</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#9966ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>換成下一個造型</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffab19;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>等待 0.3 秒</span></div><br></div>\n<div style='background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 14px;margin-bottom:10px;'><div style='font-size:.75rem;color:#64748b;margin-bottom:8px;'>✅ 重複寫法：只寫 1 次，放進迴圈</div><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffab19;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>重複 3 次</span></div><br><div style='margin-left:22px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#4c97ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>移動 30 點</span></div><br><div style='margin-left:22px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#9966ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>換成下一個造型</span></div><br><div style='margin-left:22px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffab19;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>等待 0.3 秒</span></div><br></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🚀 要走 100 步？循序寫法要拖 300 個積木；重複寫法只要把 3 改成 100！程式<strong>更短、更好改、更不容易出錯</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 3, "title": "Scratch 的三種重複積木", "chapter": "第一節：重複結構", "bg": "white", "html": "<h2 class='slide-title'>🔁 Scratch 的三種重複積木</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#fff7ed;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🔢</div><strong style='color:#9a3412;font-size:.9rem;'>重複 10 次</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'><strong>計次式</strong>：知道要做幾次<br>例：走 10 步、畫正方形重複 4 次</div></div><div style='background:#fefce8;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>⏰</div><strong style='color:#854d0e;font-size:.9rem;'>重複直到 &lt;條件&gt;</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'><strong>條件式</strong>：做到條件成立才停<br>例：一直移動，直到碰到邊緣</div></div><div style='background:#fef2f2;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>♾️</div><strong style='color:#991b1b;font-size:.9rem;'>重複無限次</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'><strong>永不停止</strong>：直到按紅色停止鈕<br>例：背景音樂一直播、角色一直跟著滑鼠</div></div></div>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> ⚠️ 「重複無限次」在遊戲裡很常用，但在<strong>計算題</strong>裡用它就會停不下來——還記得演算法的<strong>有限性</strong>嗎？</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 4, "title": "用畫筆畫正方形", "chapter": "第一節：重複結構", "bg": "white", "html": "<h2 class='slide-title'>✏️ 用畫筆畫正方形</h2>\n<div style='display:grid;grid-template-columns:1fr 1.1fr;gap:12px;'><div style='background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 14px;margin-bottom:10px;'><div style='font-size:.75rem;color:#64748b;margin-bottom:8px;'>畫筆積木在左下角「擴充功能」→「畫筆」</div><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffbf00;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>當綠旗被點擊</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#0fbd8c;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>筆跡全部清除</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#4c97ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>定位到 x: 0 y: 0</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#0fbd8c;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>下筆</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffab19;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>重複 4 次</span></div><br><div style='margin-left:22px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#4c97ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>移動 100 點</span></div><br><div style='margin-left:22px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#4c97ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>右轉 90 度</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#0fbd8c;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>停筆</span></div><br></div>\n<div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🟦</div><strong style='color:#1e40af;font-size:.9rem;'>想一想</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>🔹 正方形有 4 個邊、4 個角，所以重複 <strong>4</strong> 次<br>🔹 每次轉 <strong>90</strong> 度，4 次剛好轉一圈 360 度<br>🔹 「下筆」之後移動才會留下線條<br><br>👉 改成重複 3 次、右轉 120 度，會畫出什麼？</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 5, "title": "正多邊形的規律", "chapter": "第一節：重複結構", "bg": "white", "html": "<h2 class='slide-title'>🔺 找規律：畫任何正多邊形</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:22%;'>圖形</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:20%;'>重複次數</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:22%;'>每次右轉</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:36%;'>規律</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>正三角形</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>3</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>120 度</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>360 ÷ 3</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>正方形</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>4</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>90 度</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>360 ÷ 4</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>正五邊形</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>5</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>72 度</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>360 ÷ 5</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>正六邊形</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>6</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>60 度</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>360 ÷ 6</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>正 n 邊形</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>n</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>360 ÷ n 度</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>轉完剛好一圈</td></tr></table>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> ⭐ 挑戰：重複 5 次、每次移動 100 點、右轉 <strong>144</strong> 度，會畫出一顆<strong>星星</strong>！（5 × 144 ＝ 720，剛好轉兩圈）</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 6, "title": "第一節 隨堂測驗", "chapter": "第一節：重複結構", "bg": "purple", "quiz": "q1", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>重複結構 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 7, "title": "問題分析：1＋2＋3＋4", "chapter": "第二節：計算 1＋2＋3＋4", "bg": "white", "html": "<h2 class='slide-title'>➕ 範例：計算 1＋2＋3＋4 的值</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#fff7ed;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>📦</div><strong style='color:#9a3412;font-size:.9rem;'>需要兩個變數</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>🔹 <strong>和</strong>：目前加到多少（一開始是 0）<br>🔹 <strong>數字</strong>：這次要加的數（從 1 開始）</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🔍</div><strong style='color:#166534;font-size:.9rem;'>找規律</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>每一次都做同樣的兩件事：<br>① 和 ＝ 和 ＋ 數字<br>② 數字 ＝ 數字 ＋ 1<br>總共做 <strong>4 次</strong></div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧠 「每次做同樣的事、做固定次數」→ 用<strong>計次式迴圈</strong>！</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 8, "title": "循序 vs 重複", "chapter": "第二節：計算 1＋2＋3＋4", "bg": "white", "html": "<h2 class='slide-title'>⚖️ 循序寫法 vs 重複寫法</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 14px;margin-bottom:10px;'><div style='font-size:.75rem;color:#64748b;margin-bottom:8px;'>循序寫法：看起來很簡單……</div><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 和 設為 0</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 和 改變 1</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 和 改變 2</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 和 改變 3</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 和 改變 4</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#9966ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>說出 （和）</span></div><br></div>\n<div style='background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 14px;margin-bottom:10px;'><div style='font-size:.75rem;color:#64748b;margin-bottom:8px;'>重複寫法：多一個變數，但可以擴充</div><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 和 設為 0</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 數字 設為 1</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffab19;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>重複 4 次</span></div><br><div style='margin-left:22px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 和 改變 （數字）</span></div><br><div style='margin-left:22px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 數字 改變 1</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#9966ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>說出 （和）</span></div><br></div>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🤔 只加到 4 的話，兩種寫法差不多。但如果要加到 <strong>100</strong>？循序寫法要寫 100 個積木，重複寫法只要把 4 改成 100！</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 9, "title": "追蹤變數", "chapter": "第二節：計算 1＋2＋3＋4", "bg": "white", "html": "<h2 class='slide-title'>👣 追蹤變數：每一圈發生了什麼？</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:18%;'>第幾圈</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:20%;'>執行前 和</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:34%;'>和 改變 數字</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:28%;'>數字 改變 1</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>開始前</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>—</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>和 ＝ 0</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>數字 ＝ 1</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>第 1 圈</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>0</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>和 ＝ 0 ＋ 1 ＝ 1</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>數字 ＝ 2</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>第 2 圈</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>和 ＝ 1 ＋ 2 ＝ 3</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>數字 ＝ 3</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>第 3 圈</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>3</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>和 ＝ 3 ＋ 3 ＝ 6</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>數字 ＝ 4</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>第 4 圈</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>6</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>和 ＝ 6 ＋ 4 ＝ 10</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>數字 ＝ 5</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 ✅ 迴圈結束，說出 <strong>和 ＝ 10</strong>。用表格一圈一圈追蹤，是檢查迴圈程式最好的方法。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 10, "title": "變數初始化", "chapter": "第二節：計算 1＋2＋3＋4", "bg": "white", "html": "<h2 class='slide-title'>⚠️ 最常見的 bug：忘記「設為 0」</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#fef2f2;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🐛</div><strong style='color:#991b1b;font-size:.9rem;'>忘記把和設為 0</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>第一次按綠旗：10 ✅<br>第二次按綠旗：<strong>20</strong> ❌<br>第三次按綠旗：<strong>30</strong> ❌<br><br>因為變數會<strong>記住上一次的值</strong>，和是從 10 開始繼續加！</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🧹</div><strong style='color:#166534;font-size:.9rem;'>解法：初始化</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>在迴圈<strong>開始之前</strong>，先把變數設定好起始值：<br>和 設為 0、數字 設為 1<br><br>這個動作叫做<strong>初始化</strong>，每次執行都從乾淨的狀態開始。</div></div></div>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 💡 記住口訣：<strong>先歸零，再迴圈</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 11, "title": "第二節 隨堂測驗", "chapter": "第二節：計算 1＋2＋3＋4", "bg": "purple", "quiz": "q2", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>迴圈累加 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 12, "title": "擴充：1＋2＋…＋N", "chapter": "第三節：計算 1＋2＋…＋N", "bg": "white", "html": "<h2 class='slide-title'>🚀 擴充：讓使用者決定要加到多少</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 14px;margin-bottom:10px;'><div style='font-size:.75rem;color:#64748b;margin-bottom:8px;'>把「重複 4 次」的 4 換成變數 N</div><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffbf00;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>當綠旗被點擊</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#5cb1d6;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>詢問 要從 1 加到多少？ 並等待</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 N 設為 （答案）</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 和 設為 0</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 數字 設為 1</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffab19;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>重複 （N） 次</span></div><br><div style='margin-left:22px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 和 改變 （數字）</span></div><br><div style='margin-left:22px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 數字 改變 1</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#9966ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>說出 字串組合 總和是 （和）</span></div><br></div>\n<div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🔧</div><strong style='color:#1e40af;font-size:.9rem;'>改了哪裡？</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>🔹 多一個「詢問」讓使用者輸入 N<br>🔹 「重複 4 次」→「重複 <strong>N</strong> 次」<br>🔹 其他積木<strong>完全不用改</strong>！<br><br>這就是重複結構的<strong>擴充彈性</strong>。</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 13, "title": "1＋2＋…＋N 流程圖", "chapter": "第三節：計算 1＋2＋…＋N", "bg": "white", "html": "<h2 class='slide-title'>🔀 1＋2＋…＋N 的流程圖</h2>\n<div style='display:grid;grid-template-columns:1.5fr 1fr;gap:12px;'><div style='display:flex;flex-direction:column;align-items:flex-start;gap:0;'><div style='display:flex;align-items:center;'><div style='width:230px;display:flex;justify-content:center;'><div style='border-radius:999px;background:#1e3a5f;color:#fff;width:170px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>開始</div></div></div><div style='width:230px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:230px;display:flex;justify-content:center;'><div style='clip-path:polygon(10% 0,100% 0,90% 100%,0 100%);background:#dcfce7;color:#14532d;width:170px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>輸入 N</div></div></div><div style='width:230px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:230px;display:flex;justify-content:center;'><div style='border-radius:4px;background:#dbeafe;color:#1e3a8a;width:170px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>和 ＝ 0、數字 ＝ 1</div></div></div><div style='width:230px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:230px;display:flex;justify-content:center;'><div style='clip-path:polygon(8% 0,92% 0,100% 50%,92% 100%,8% 100%,0 50%);background:#ede9fe;color:#4c1d95;width:170px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>重複 N 次</div></div></div><div style='width:230px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:230px;display:flex;justify-content:center;'><div style='border-radius:4px;background:#dbeafe;color:#1e3a8a;width:170px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>和 ＝ 和 ＋ 數字</div></div><div style='font-size:.75rem;color:#b45309;font-weight:600;margin-left:10px;'>（迴圈內）</div></div><div style='width:230px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:230px;display:flex;justify-content:center;'><div style='border-radius:4px;background:#dbeafe;color:#1e3a8a;width:170px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>數字 ＝ 數字 ＋ 1</div></div><div style='font-size:.75rem;color:#b45309;font-weight:600;margin-left:10px;'>（迴圈內）→ 回到「重複 N 次」</div></div><div style='width:230px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:230px;display:flex;justify-content:center;'><div style='clip-path:polygon(10% 0,100% 0,90% 100%,0 100%);background:#dcfce7;color:#14532d;width:170px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>輸出 和</div></div><div style='font-size:.75rem;color:#b45309;font-weight:600;margin-left:10px;'>（重複完 N 次後）</div></div><div style='width:230px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:230px;display:flex;justify-content:center;'><div style='border-radius:999px;background:#1e3a5f;color:#fff;width:170px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>結束</div></div></div></div>\n<div style='background:#f5f3ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>📖</div><strong style='color:#5b21b6;font-size:.9rem;'>對照第 8–9 週</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>🔹 六邊形＝<strong>迴圈</strong>符號，寫出要重複幾次<br>🔹 迴圈裡的兩個步驟會一直做，做滿 N 次才往下<br><br>流程圖和 Scratch 程式是<strong>一對一</strong>對應的！</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 14, "title": "高斯的聰明算法", "chapter": "第三節：計算 1＋2＋…＋N", "bg": "white", "html": "<h2 class='slide-title'>🧠 小故事：高斯的聰明算法</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#fefce8;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>👦</div><strong style='color:#854d0e;font-size:.9rem;'>一個常被流傳的故事</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>據說數學家<strong>高斯</strong>小時候，老師要全班算 1＋2＋…＋100。<br>高斯發現：1＋100、2＋99、3＋98……每一對都是 <strong>101</strong>，共 50 對。<br>101 × 50 ＝ <strong>5050</strong>！</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>✅</div><strong style='color:#166534;font-size:.9rem;'>用公式驗證你的程式</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>1＋2＋…＋N ＝ N × (N＋1) ÷ 2<br><br>🔹 N ＝ 4 → 4 × 5 ÷ 2 ＝ 10 ✅<br>🔹 N ＝ 100 → 100 × 101 ÷ 2 ＝ 5050 ✅<br><br>輸入 100 給你的程式，結果是 5050 嗎？</div></div></div>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 💬 同一個問題，「迴圈一個一個加」和「用公式一次算」都是演算法——又一次證明<strong>一個問題可以有多種演算法</strong>！</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 15, "title": "第三節 隨堂測驗", "chapter": "第三節：計算 1＋2＋…＋N", "bg": "purple", "quiz": "q3", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>1＋2＋…＋N ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 16, "title": "這學期的學習地圖", "chapter": "第四節：學期總結", "bg": "white", "html": "<h2 class='slide-title'>🗺️ 這學期我們學了什麼？</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;'><strong style='color:#1e40af;font-size:.9rem;'>🖥️ 電腦的身體（W1–5）</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>計算工具演進、電子元件五世代、五大單元、記憶體、儲存單位、周邊設備、Dream PC 試算表</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><strong style='color:#166534;font-size:.9rem;'>🧠 電腦的思考（W6–9）</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>演算法五大特性、運算思維、流程圖符號與繪製</div></div><div style='background:#f5f3ff;padding:14px;border-radius:10px;'><strong style='color:#5b21b6;font-size:.9rem;'>💬 和電腦對話（W10–15）</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>程式語言演進、結構化程式設計、Scratch 變數、循序與重複結構</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🔗 一條線串起來：<strong>硬體</strong>負責執行 → <strong>演算法</strong>決定步驟 → <strong>程式</strong>把步驟告訴硬體。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 17, "title": "前後呼應", "chapter": "第四節：學期總結", "bg": "white", "html": "<h2 class='slide-title'>🔗 你發現了嗎？這些概念一直在出現</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:18%;'>概念</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:36%;'>第一次出現</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:46%;'>後來又出現在</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>0 與 1</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>打孔卡「有孔／沒孔」（W1）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>電晶體開關（W2）、bit（W4）、機器語言（W10）</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>五大單元</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>巴貝奇分析機（W1）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>電腦硬體架構（W3）</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>判斷／選擇</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>試算表 IF 函數（W5）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>流程圖菱形（W8）、選擇結構（W10）</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>重複</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>提花織布機（W10）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>流程圖繞回去（W8）、Scratch 迴圈（W14）</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>有限性</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>洗髮精說明（W6）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>無窮迴圈、重複無限次（W14）</td></tr></table>\n", "quiz": null, "chart": null, "video": null}, {"id": 18, "title": "下學期預告", "chapter": "第四節：學期總結", "bg": "teal", "html": "\n<div style='text-align:center;padding:12px 10px 4px;'>\n  <div style='font-size:48px;margin-bottom:8px;'>🚀</div>\n  <h2 style='font-size:1.6rem;font-weight:800;color:#fff;margin-bottom:6px;'>第三學期預告</h2>\n  <p style='color:#ccfbf1;font-size:.95rem;margin-bottom:16px;'>從「照順序做」和「重複做」，進階到「會判斷」的程式</p>\n</div>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;'><div style='background:rgba(255,255,255,.12);border-radius:10px;padding:12px 14px;'><strong style='color:#fff;font-size:.9rem;'>🔀 選擇結構</strong><p style='color:#ccfbf1;font-size:.8rem;margin-top:5px;line-height:1.7;'>如果……就……否則……：成績判斷、遊戲得分</p></div><div style='background:rgba(255,255,255,.12);border-radius:10px;padding:12px 14px;'><strong style='color:#fff;font-size:.9rem;'>🎮 互動程式</strong><p style='color:#ccfbf1;font-size:.8rem;margin-top:5px;line-height:1.7;'>結合循序、選擇、重複，做出小遊戲</p></div><div style='background:rgba(255,255,255,.12);border-radius:10px;padding:12px 14px;'><strong style='color:#fff;font-size:.9rem;'>🎪 生活應用專題</strong><p style='color:#ccfbf1;font-size:.8rem;margin-top:5px;line-height:1.7;'>配合學習慶典，用程式解決生活中的問題</p></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 19, "title": "第四節 隨堂測驗", "chapter": "第四節：學期總結", "bg": "purple", "quiz": "q4", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第四節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>學期總複習 ｜ 4 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 20, "title": "個人實作：重複結構程式", "chapter": "個人實作", "bg": "white", "html": "<h2 class='slide-title'>🔁 個人實作：用重複結構寫程式（三選二）</h2>\n<div style='background:#eff6ff;border-radius:12px;padding:16px;margin-bottom:12px;'><p style='color:#1e40af;font-size:.9rem;font-weight:700;margin-bottom:8px;'>📋 每題都要附流程圖和追蹤表（至少追蹤 3 圈），程式連結貼到 Google 文件</p><div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#f8fafc;padding:14px;border-radius:10px;'><strong style='color:#334155;font-size:.9rem;'>題目 A：1＋2＋…＋N</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>輸入 N，輸出總和。用 N＝100 驗證是否為 5050</div></div><div style='background:#f8fafc;padding:14px;border-radius:10px;'><strong style='color:#334155;font-size:.9rem;'>題目 B：2 的 n 次方</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>輸入 n，結果先設為 1，重複 n 次「結果 ＝ 結果 × 2」，輸出結果</div></div><div style='background:#f8fafc;padding:14px;border-radius:10px;'><strong style='color:#334155;font-size:.9rem;'>題目 C：正多邊形畫家</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>輸入邊數 n，用畫筆畫出正 n 邊形（每次右轉 360 ÷ n 度）</div></div></div>\n</div><div style='background:#fffbeb;border-radius:10px;padding:14px;'><strong style='color:#92400e;font-size:.9rem;'>📏 評分（課程計畫：程式設計）</strong><p style='font-size:.78rem;color:#334155;margin-top:6px;line-height:1.8;'><strong style='color:#059669;'>A</strong> 能優化結構化（循序、重複）程式，並能以追蹤表說明<br><strong style='color:#2563eb;'>B</strong> 能產出正確的循序與重複結構程式<br><strong style='color:#d97706;'>C</strong> 能仿作循序與重複結構程式<br><strong style='color:#dc2626;'>D</strong> 僅能部分完成程式</p></div>", "quiz": null, "chart": null, "video": null}, {"id": 21, "title": "學期總結", "chapter": "個人實作", "bg": "navy", "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 第 14–15 週 重點回顧</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>三種重複積木</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>重複 N 次（計次式）、重複直到（條件式）、重複無限次</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>累加</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>和 改變 數字、數字 改變 1；先初始化（歸零）再迴圈</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>擴充彈性</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>把次數換成變數 N，同一支程式就能算任意範圍</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>學期主線</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>硬體執行 → 演算法決定步驟 → 程式告訴硬體</p></div></div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>恭喜完成第二學期！Stay Hungry, Stay Foolish！</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>第三學期：選擇結構與生活應用專題</p>\n</div>\n", "quiz": null, "chart": null, "video": null}]