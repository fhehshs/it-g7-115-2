[{"id": 1, "title": "儲存單位與周邊設備", "chapter": "封面", "bg": "navy", "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>💾</div>\n  <h1 style='font-size:2.6rem;font-weight:900;color:#fff;margin-bottom:10px;'>儲存單位與周邊設備</h1>\n  <h2 style='font-size:1.25rem;font-weight:400;color:#93c5fd;margin-bottom:24px;'>Storage Units · Peripheral Devices</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;'><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🟦 bit / Byte</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>📏 KB → TB</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>⌨️ 輸入輸出</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🔍 規格查詢</span></div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>七年級第二學期 ｜ 第 4 週</p>\n</div>\n", "quiz": null, "chart": null, "video": null}, {"id": 2, "title": "為什麼電腦只用 0 和 1？", "chapter": "第一節：bit 與 Byte", "bg": "white", "html": "<h2 class='slide-title'>💡 為什麼電腦只用 0 和 1？</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>📖 電腦裡的開關（電晶體）只有兩種狀態：<strong>通電＝1、不通電＝0</strong>。只分兩種，電路最簡單、最不容易出錯，這種計數方式叫做<strong>二進位</strong>。</p></div>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#fef2f2;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>😵</div><strong style='color:#991b1b;font-size:.9rem;'>如果用十進位…</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>電路要分辨 0～9 共 10 種電壓，只要電壓稍微不穩就會讀錯。</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>😎</div><strong style='color:#166534;font-size:.9rem;'>用二進位</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>只要分辨「有電／沒電」，就算電壓有點不穩也不會讀錯。</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🗂️ 還記得打孔卡的「有孔／沒孔」嗎？概念完全一樣！</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 3, "title": "bit 與 Byte", "chapter": "第一節：bit 與 Byte", "bg": "white", "html": "<h2 class='slide-title'>🟦 bit（位元）與 Byte（位元組）</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🟦</div><strong style='color:#1e40af;font-size:.9rem;'>bit 位元（小寫 b）</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>最小的資料單位，只能是 <strong>0 或 1</strong>。</div></div><div style='background:#f5f3ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🟦🟦</div><strong style='color:#5b21b6;font-size:.9rem;'>Byte 位元組（大寫 B）</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'><strong>1 Byte ＝ 8 bits</strong>，是表示資料的基本單位。</div></div></div>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:60%;'>資料</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:40%;'>大約需要多少空間</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1 個英文字母（例如 A）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1 Byte</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1 個中文字（常用的 UTF-8 編碼）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>3 Bytes</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1 個表情符號 😀</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>4 Bytes</td></tr></table>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> ⚠️ 小心大小寫：網速常用 <strong>Mbps</strong>（小 b＝bit），檔案大小用 <strong>MB</strong>（大 B＝Byte）。100 Mbps 下載速度 ≈ 每秒 12.5 MB。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 4, "title": "幾個 bit 能表示幾種狀態？", "chapter": "第一節：bit 與 Byte", "bg": "white", "html": "<h2 class='slide-title'>🔢 幾個 bit 可以表示幾種狀態？</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:16%;'>bit 數</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:62%;'>所有組合</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:22%;'>種類數</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>0、1</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>2</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>2</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>00、01、10、11</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>4</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>3</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>000、001、010、011、100、101、110、111</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>8</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>8（1 Byte）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>00000000 ～ 11111111</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>256</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧠 規律：每多 1 個 bit，種類就<strong>乘以 2</strong>。n 個 bit ＝ 2 的 n 次方種。1 Byte 有 256 種，剛好夠表示所有英文大小寫字母、數字和符號。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 5, "title": "活動：用手指數二進位", "chapter": "第一節：bit 與 Byte", "bg": "white", "html": "<h2 class='slide-title'>✋ 活動：一隻手可以數到 31！</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;'>手指</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;'>小指</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;'>無名指</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;'>中指</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;'>食指</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;'>拇指</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>代表的數</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>16</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>8</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>4</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>2</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1</td></tr></table>\n<div style='display:flex;flex-direction:column;gap:8px;margin-bottom:12px;'><div style='display:flex;gap:12px;align-items:flex-start;background:#f0fdf4;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#16a34a;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>1</div><div><strong style='color:#166534;font-size:.88rem;'>伸出＝1、彎下＝0</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>從右邊的拇指開始，每根手指代表的數是前一根的 2 倍</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f0fdf4;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#16a34a;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>2</div><div><strong style='color:#166534;font-size:.88rem;'>把伸出的手指加起來</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>例如只伸出食指和拇指：2 ＋ 1 ＝ 3，寫成二進位就是 00011</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f0fdf4;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#16a34a;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>3</div><div><strong style='color:#166534;font-size:.88rem;'>挑戰</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>用手指比出 5、10、19；全部伸出是多少？</div></div></div></div>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 🎉 答案：5＝00101、10＝01010、19＝10011；五根全伸＝16＋8＋4＋2＋1＝<strong>31</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 6, "title": "第一節 隨堂測驗", "chapter": "第一節：bit 與 Byte", "bg": "purple", "quiz": "q1", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>bit、Byte 與二進位 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 7, "title": "儲存單位階梯", "chapter": "第二節：從 KB 到 TB", "bg": "white", "html": "<h2 class='slide-title'>📏 儲存單位階梯：每一階約 1,024 倍</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:24%;'>單位</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>換算</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:46%;'>生活例子（約略）</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>KB 千位元組</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1 KB ＝ 1,024 Bytes</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>一則純文字短訊息、一頁純文字筆記</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>MB 百萬位元組</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1 MB ＝ 1,024 KB</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>一張手機照片約 2–5 MB、一首 MP3 約 3–5 MB</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>GB 十億位元組</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1 GB ＝ 1,024 MB</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>一部高畫質電影約 1–4 GB；手機 RAM 8 GB</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>TB 兆位元組</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1 TB ＝ 1,024 GB</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>常見的電腦硬碟容量</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>PB 千兆位元組</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1 PB ＝ 1,024 TB</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>大型資料中心、雲端服務</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧠 口訣：<strong>K → M → G → T → P</strong>，每往上一階就是約一千倍（精確是 1,024 ＝ 2 的 10 次方）。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 8, "title": "為什麼 1 TB 硬碟只顯示 931 GB？", "chapter": "第二節：從 KB 到 TB", "bg": "white", "html": "<h2 class='slide-title'>🤔 買了 1 TB 硬碟，為什麼電腦只顯示約 931 GB？</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#fff7ed;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🏭</div><strong style='color:#9a3412;font-size:.9rem;'>廠商：用 1,000 算</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>硬碟廠商用十進位：<br>1 TB ＝ 1,000,000,000,000 Bytes</div></div><div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>💻</div><strong style='color:#1e40af;font-size:.9rem;'>Windows：用 1,024 算</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>作業系統用二進位：<br>1,000,000,000,000 ÷ 1,024 ÷ 1,024 ÷ 1,024 <br>≈ <strong>931 GB</strong></div></div></div>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> ✅ 沒有被偷容量！只是<strong>兩邊的算法不同</strong>。另外系統本身和預裝軟體也會佔用一些空間，所以實際可用的會更少。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 9, "title": "換算練習", "chapter": "第二節：從 KB 到 TB", "bg": "white", "html": "<h2 class='slide-title'>🧮 換算練習（用約 1,000 倍估算即可）</h2>\n<div style='display:flex;flex-direction:column;gap:8px;margin-bottom:12px;'><div style='display:flex;gap:12px;align-items:flex-start;background:#eff6ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#2563eb;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>1</div><div><strong style='color:#1e40af;font-size:.88rem;'>一支 64 GB 的隨身碟，大約可以放幾張 4 MB 的照片？</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>64 GB ≈ 64,000 MB；64,000 ÷ 4 ＝ <strong>約 16,000 張</strong></div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#eff6ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#2563eb;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>2</div><div><strong style='color:#1e40af;font-size:.88rem;'>一部 2 GB 的電影，128 GB 手機剩 20 GB，可以下載幾部？</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>20 ÷ 2 ＝ <strong>10 部</strong></div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#eff6ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#2563eb;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>3</div><div><strong style='color:#1e40af;font-size:.88rem;'>一首 4 MB 的歌，1 GB 大約可以放幾首？</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>1 GB ≈ 1,000 MB；1,000 ÷ 4 ＝ <strong>約 250 首</strong></div></div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 💡 估算時用 1,000 比較好算；要精確時才用 1,024。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 10, "title": "我的手機空間去哪了？", "chapter": "第二節：從 KB 到 TB", "bg": "white", "html": "<h2 class='slide-title'>📱 我的手機空間都去哪了？</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#fef2f2;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🎬</div><strong style='color:#991b1b;font-size:.9rem;'>影片</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>1 分鐘 1080p 影片約 60–130 MB；4K 更大</div></div><div style='background:#fefce8;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🖼️</div><strong style='color:#854d0e;font-size:.9rem;'>照片與截圖</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>每張數 MB，累積幾千張就是好幾 GB</div></div><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🎮</div><strong style='color:#1e40af;font-size:.9rem;'>App 與快取</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>遊戲 App 常常好幾 GB；社群 App 的快取也會越來越大</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🔍 <strong>回家任務</strong>：到手機「設定 → 儲存空間」看看哪一類最佔空間？（只看類別，不用截圖給別人）<br>💡 整理技巧：刪掉重複照片、清除 App 快取、把影片備份到雲端。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 11, "title": "第二節 隨堂測驗", "chapter": "第二節：從 KB 到 TB", "bg": "purple", "quiz": "q2", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>儲存單位換算 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 12, "title": "輸入設備", "chapter": "第三節：周邊設備", "bg": "white", "html": "<h2 class='slide-title'>📥 輸入設備：把資料「送進」電腦</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>📖 <strong>周邊設備</strong>（Peripheral）：主機以外，幫助電腦和外界溝通的設備，分成輸入、輸出、兼具兩者。</p></div>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>⌨️</div><strong style='color:#1e40af;font-size:.9rem;'>鍵盤、滑鼠</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>最基本的輸入工具</div></div><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🎤</div><strong style='color:#1e40af;font-size:.9rem;'>麥克風</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>語音輸入、視訊通話</div></div><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>📷</div><strong style='color:#1e40af;font-size:.9rem;'>攝影機</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>視訊、人臉辨識</div></div><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🖨️</div><strong style='color:#1e40af;font-size:.9rem;'>掃描器</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>把紙本圖文變成數位檔</div></div><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🏷️</div><strong style='color:#1e40af;font-size:.9rem;'>條碼／QR Code 掃描</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>超商結帳、圖書館借書</div></div><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🌡️</div><strong style='color:#1e40af;font-size:.9rem;'>感測器</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>溫度、光線、動作感測</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 13, "title": "輸出設備", "chapter": "第三節：周邊設備", "bg": "white", "html": "<h2 class='slide-title'>📤 輸出設備：把結果「送出」給人看、聽</h2>\n<div style='display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px;'><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🖥️</div><strong style='color:#166534;font-size:.9rem;'>螢幕</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>液晶、OLED 顯示畫面</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🖨️</div><strong style='color:#166534;font-size:.9rem;'>印表機</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>把資料印在紙上</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🔊</div><strong style='color:#166534;font-size:.9rem;'>喇叭／耳機</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>輸出聲音</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>📽️</div><strong style='color:#166534;font-size:.9rem;'>投影機</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>把畫面投到大螢幕</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🤔 <strong>想一想</strong>：3D 印表機算輸入還是輸出設備？（答：輸出——它把電腦裡的設計變成實體物品）</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 14, "title": "兼具輸入與輸出", "chapter": "第三節：周邊設備", "bg": "white", "html": "<h2 class='slide-title'>🔄 兼具輸入與輸出的設備</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#f5f3ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>📱</div><strong style='color:#5b21b6;font-size:.9rem;'>觸控螢幕</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>手指觸碰＝輸入；顯示畫面＝輸出。手機、平板、教室觸控大螢幕</div></div><div style='background:#f5f3ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🏪</div><strong style='color:#5b21b6;font-size:.9rem;'>超商多媒體機</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>例如 ibon：觸控選服務（輸入）、顯示並列印單據（輸出）</div></div><div style='background:#f5f3ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🔌</div><strong style='color:#5b21b6;font-size:.9rem;'>隨身碟／外接硬碟</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>可以讀取（輸入）也能寫入（輸出）資料</div></div></div>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 🧠 判斷方法：看資料<strong>流動的方向</strong>。資料進電腦＝輸入、出電腦＝輸出、兩個方向都有＝兼具。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 15, "title": "分類挑戰", "chapter": "第三節：周邊設備", "bg": "white", "html": "<h2 class='slide-title'>🧩 分類挑戰：輸入？輸出？兼具？</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:36%;'>設備</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:22%;'>你的答案</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:42%;'>理由</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>捷運閘門的悠遊卡感應器</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>？</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>？</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>智慧手錶</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>？</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>？</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>VR 頭戴裝置</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>？</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>？</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>電子白板</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>？</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>？</td></tr></table>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 🗣️ 小組討論 2 分鐘。參考答案：感應器＝輸入（讀取卡片資料）；智慧手錶、VR 頭戴裝置、電子白板＝兼具（有感測／觸控，也有螢幕顯示）。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 16, "title": "第三節 隨堂測驗", "chapter": "第三節：周邊設備", "bg": "purple", "quiz": "q3", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>輸入、輸出與兼具設備 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 17, "title": "Windows 規格查詢", "chapter": "第四節：規格查詢 Lab", "bg": "white", "html": "<h2 class='slide-title'>🔍 規格查詢：Windows 電腦</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>⚙️</div><strong style='color:#1e40af;font-size:.9rem;'>方法 1：設定</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>開始 → 設定 → 系統 → 系統資訊<br>看到：處理器、已安裝的 RAM、裝置名稱</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>ℹ️</div><strong style='color:#166534;font-size:.9rem;'>方法 2：系統資訊</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>按 Win＋R → 輸入 <code>msinfo32</code> → Enter<br>看到：完整硬體規格</div></div><div style='background:#f5f3ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>📊</div><strong style='color:#5b21b6;font-size:.9rem;'>方法 3：工作管理員</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>按 Ctrl＋Shift＋Esc → 效能<br>看到：CPU 使用率、記憶體用量、磁碟</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 💡 打開工作管理員後，同時開幾個網頁，觀察 CPU 和記憶體使用率怎麼變化！</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 18, "title": "Chromebook 與手機規格查詢", "chapter": "第四節：規格查詢 Lab", "bg": "white", "html": "<h2 class='slide-title'>🔍 規格查詢：Chromebook 與手機</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:18%;'>裝置</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:50%;'>查詢方法</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:32%;'>可以看到</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>Chromebook</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>設定 → 關於 ChromeOS；或在網址列輸入 <code>chrome://system</code></td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>作業系統版本、CPU、記憶體</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>Chromebook</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>開啟「診斷」App</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>CPU、記憶體、電池即時狀態</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>Android 手機</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>設定 → 關於手機</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>型號、處理器、RAM、儲存空間</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>iPhone</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>設定 → 一般 → 關於本機</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>型號、容量、可用空間</td></tr></table>\n<div style='background:#fef2f2;padding:11px 16px;border-radius:8px;border-left:4px solid #dc2626;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>⚠️ 🔒 <strong>隱私提醒</strong>：關於本機頁面也會顯示<strong>序號、IMEI</strong>，這些是裝置的身分證，不要拍照上傳或給別人。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 19, "title": "第四節 隨堂測驗", "chapter": "第四節：規格查詢 Lab", "bg": "purple", "quiz": "q4", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第四節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>規格查詢 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 20, "title": "個人實作：電腦教室規格調查", "chapter": "個人實作", "bg": "white", "html": "<h2 class='slide-title'>📝 個人實作：電腦教室規格調查表</h2>\n<div style='background:#eff6ff;border-radius:12px;padding:16px;margin-bottom:12px;'><p style='color:#1e40af;font-size:.9rem;font-weight:700;margin-bottom:8px;'>📋 在 Google 文件完成以下表格</p><table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:34%;'>項目</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:36%;'>查到的規格</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>用哪個方法查到的</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>處理器（CPU）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'></td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'></td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>記憶體（RAM）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'></td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'></td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>儲存裝置與容量</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'></td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'></td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>可用空間</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'></td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'></td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>連接的周邊設備（列出 3 種並分類）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'></td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'></td></tr></table>\n</div><div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#f0fdf4;border-radius:10px;padding:14px;'><strong style='color:#166534;font-size:.9rem;'>🧠 思考題（寫在表格下方）</strong><ul style='color:#334155;font-size:.8rem;line-height:1.85;padding-left:18px;margin:6px 0 0;'><li>這台電腦的硬碟可以放幾部 2 GB 的電影？寫出算式</li><li>如果要拿來剪輯影片，你建議升級哪個零件？為什麼？</li></ul></div><div style='background:#fffbeb;border-radius:10px;padding:14px;'><strong style='color:#92400e;font-size:.9rem;'>📏 評分（規準：資料處理）</strong><p style='font-size:.78rem;color:#334155;margin-top:6px;line-height:1.8;'><strong style='color:#059669;'>A</strong> 規格完整正確，換算與建議有清楚根據<br><strong style='color:#2563eb;'>B</strong> 表格完成且正確<br><strong style='color:#d97706;'>C</strong> 引導下完成大部分表格<br><strong style='color:#dc2626;'>D</strong> 僅完成部分表格</p></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 21, "title": "本章重點回顧", "chapter": "個人實作", "bg": "navy", "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 第 4 週 重點回顧</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>bit 與 Byte</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>1 Byte ＝ 8 bits；n 個 bit 可表示 2 的 n 次方種狀態</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>單位階梯</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>KB → MB → GB → TB → PB，每階約 1,024 倍</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>周邊設備</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>輸入（鍵盤、麥克風）、輸出（螢幕、喇叭）、兼具（觸控螢幕、隨身碟）</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>規格查詢</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>Windows：設定／msinfo32／工作管理員；Chromebook：chrome://system</p></div></div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>預算 3 萬元，怎麼用試算表挑出最適合的電腦？</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>下一週：夢想電腦 Dream PC 試算表</p>\n</div>\n", "quiz": null, "chart": null, "video": null}]