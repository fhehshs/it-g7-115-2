[{"id": 1, "title": "Scratch 入門：變數與循序結構", "chapter": "封面", "bg": "navy", "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>🐱</div>\n  <h1 style='font-size:2.6rem;font-weight:900;color:#fff;margin-bottom:10px;'>Scratch 入門：變數與循序結構</h1>\n  <h2 style='font-size:1.25rem;font-weight:400;color:#93c5fd;margin-bottom:24px;'>Scratch Basics · Variables & Sequence</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;'><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🚩 事件</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>📦 變數</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>➗ 運算積木</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🐛 除錯</span></div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>七年級第二學期 ｜ 第 12–13 週</p>\n</div>\n", "quiz": null, "chart": null, "video": null}, {"id": 2, "title": "事件：程式從哪裡開始？", "chapter": "第一節：Scratch 基本操作", "bg": "white", "html": "<h2 class='slide-title'>🚩 事件積木：程式從哪裡開始？</h2>\n<div style='display:grid;grid-template-columns:1fr 1.2fr;gap:12px;'><div style='background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 14px;margin-bottom:10px;'><div style='font-size:.75rem;color:#64748b;margin-bottom:8px;'>常用的黃色事件積木（帽子形狀）</div><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffbf00;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>當綠旗被點擊</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffbf00;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>當角色被點擊</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffbf00;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>當 空白 鍵被按下</span></div><br></div>\n<div style='background:#fefce8;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🎩</div><strong style='color:#854d0e;font-size:.9rem;'>帽子積木</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>事件積木上面是圓弧形，像一頂帽子——<strong>只能放在程式的最上方</strong>。<br><br>它決定「什麼時候」開始執行下面的積木。沒有接在帽子積木下的程式，按綠旗不會執行！</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 3, "title": "積木分類", "chapter": "第一節：Scratch 基本操作", "bg": "white", "html": "<h2 class='slide-title'>🎨 常用積木分類</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:22%;'>顏色／分類</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>做什麼</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:48%;'>例子</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🟦 動作</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>移動、旋轉、改變位置</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>移動 10 點、右轉 15 度、定位到 x:0 y:0</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🟪 外觀</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>說話、換造型、顯示隱藏</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>說出 Hello! 持續 2 秒、換成下一個造型</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🟨 事件</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>決定程式何時開始</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>當綠旗被點擊</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🟧 控制</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>等待、重複、判斷</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>等待 1 秒、重複 10 次</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🩵 偵測</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>詢問、偵測碰撞與按鍵</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>詢問 What's your name? 並等待、答案</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🟩 運算</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>加減乘除、比較大小</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>( ) + ( )、( ) &gt; ( )</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>🟠 變數</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>建立與修改變數</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>變數 分數 設為 0</td></tr></table>\n", "quiz": null, "chart": null, "video": null}, {"id": 4, "title": "第一個動畫：走路的貓", "chapter": "第一節：Scratch 基本操作", "bg": "white", "html": "<h2 class='slide-title'>🚶 第一個動畫：讓貓咪走路</h2>\n<div style='display:grid;grid-template-columns:1fr 1.1fr;gap:12px;'><div style='background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 14px;margin-bottom:10px;'><div style='font-size:.75rem;color:#64748b;margin-bottom:8px;'>循序結構：由上而下一步一步執行</div><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffbf00;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>當綠旗被點擊</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#4c97ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>定位到 x: -150 y: 0</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#4c97ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>移動 30 點</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#9966ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>換成下一個造型</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffab19;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>等待 0.3 秒</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#4c97ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>移動 30 點</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#9966ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>換成下一個造型</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffab19;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>等待 0.3 秒</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#4c97ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>移動 30 點</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#9966ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>換成下一個造型</span></div><br></div>\n<div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>💡</div><strong style='color:#1e40af;font-size:.9rem;'>試試看</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>🔹 拿掉「等待」會怎樣？（太快了，看不到走路動作）<br>🔹 為什麼一開始要「定位」？（每次按綠旗都從同一個地方出發）<br><br>🤔 「移動、換造型、等待」重複寫了 3 次……有沒有更聰明的寫法？（第 14 週揭曉）</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 5, "title": "舞台座標", "chapter": "第一節：Scratch 基本操作", "bg": "white", "html": "<h2 class='slide-title'>📍 舞台座標：角色在哪裡？</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🎭</div><strong style='color:#1e40af;font-size:.9rem;'>舞台大小</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>寬 480、高 360<br>正中央是 <strong>(0, 0)</strong></div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>↔️</div><strong style='color:#166534;font-size:.9rem;'>x 座標（左右）</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>從 -240（最左）到 240（最右）<br>往右 x 變大</div></div><div style='background:#f5f3ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>↕️</div><strong style='color:#5b21b6;font-size:.9rem;'>y 座標（上下）</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>從 -180（最下）到 180（最上）<br>往上 y 變大</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧭 和數學課的座標平面一樣！把滑鼠移到舞台上，就能在角色資訊看到目前位置的 x、y。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 6, "title": "第一節 隨堂測驗", "chapter": "第一節：Scratch 基本操作", "bg": "purple", "quiz": "q1", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>Scratch 基本操作 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 7, "title": "變數是什麼？", "chapter": "第二節：變數", "bg": "white", "html": "<h2 class='slide-title'>📦 變數：貼了標籤的盒子</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #ea580c;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>📖 程式執行時，常常需要<strong>暫時記住</strong>一些資料（分數、名字、輸入的數字）。我們給它取一個名字存起來，因為內容可以改變，所以叫做<strong>變數</strong>。</p></div>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#fff7ed;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🏷️</div><strong style='color:#9a3412;font-size:.9rem;'>名稱</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>盒子上的標籤，例如「分數」「A」「平均」</div></div><div style='background:#fefce8;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>📦</div><strong style='color:#854d0e;font-size:.9rem;'>內容（值）</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>盒子裡裝的東西，例如 85</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🔄</div><strong style='color:#166534;font-size:.9rem;'>可以改變</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>可以放新的值進去，舊的值就被取代</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🎮 遊戲裡的「分數」「生命值」「金幣」，在程式裡都是變數。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 8, "title": "建立變數", "chapter": "第二節：變數", "bg": "white", "html": "<h2 class='slide-title'>🛠️ 在 Scratch 建立變數</h2>\n<div style='display:flex;flex-direction:column;gap:8px;margin-bottom:12px;'><div style='display:flex;gap:12px;align-items:flex-start;background:#fff7ed;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#ea580c;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>1</div><div><strong style='color:#9a3412;font-size:.88rem;'>點選「變數」分類</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>積木區左邊的橘色圓點</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#fff7ed;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#ea580c;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>2</div><div><strong style='color:#9a3412;font-size:.88rem;'>按「建立一個變數」</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>會跳出「新的變數」視窗</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#fff7ed;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#ea580c;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>3</div><div><strong style='color:#9a3412;font-size:.88rem;'>輸入名稱、選擇範圍</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>名稱要看得懂（例如「平均」而不是「a1」）；範圍先選「適用於所有角色」</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#fff7ed;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#ea580c;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>4</div><div><strong style='color:#9a3412;font-size:.88rem;'>按確定</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>積木區就會出現這個變數和相關積木，勾選後舞台會顯示它的值</div></div></div></div>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 💡 取名好習慣：用<strong>有意義的名字</strong>，一看就知道它存什麼，除錯時會輕鬆很多。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 9, "title": "變數積木", "chapter": "第二節：變數", "bg": "white", "html": "<h2 class='slide-title'>🧱 常用的變數積木</h2>\n<div style='display:grid;grid-template-columns:1fr 1.3fr;gap:12px;'><div style='background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 14px;margin-bottom:10px;'><div style='font-size:.75rem;color:#64748b;margin-bottom:8px;'>橘色變數積木</div><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 分數 設為 0</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 分數 改變 10</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>顯示變數 分數</span></div><br></div>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>積木</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:45%;'>意思</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:25%;'>執行後分數＝</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>設為 0</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>把盒子清空，放進 0</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>0</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>改變 10</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>在原本的值上<strong>加</strong> 10</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>10</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>再改變 10</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>再加 10</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>20</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>改變 -5</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>加 -5（等於減 5）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>15</td></tr></table>\n</div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 ⚠️ 「設為」是<strong>換掉</strong>內容；「改變」是<strong>加上</strong>去。這兩個常常被搞混！</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 10, "title": "詢問與答案", "chapter": "第二節：變數", "bg": "white", "html": "<h2 class='slide-title'>💬 詢問與答案：讓使用者輸入資料</h2>\n<div style='display:grid;grid-template-columns:1.1fr 1fr;gap:12px;'><div style='background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 14px;margin-bottom:10px;'><div style='font-size:.75rem;color:#64748b;margin-bottom:8px;'>偵測類的「詢問」與「答案」</div><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffbf00;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>當綠旗被點擊</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#5cb1d6;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>詢問 你叫什麼名字？ 並等待</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 名字 設為 （答案）</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#9966ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>說出 字串組合 你好， （名字） 持續 2 秒</span></div><br></div>\n<div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>⌨️</div><strong style='color:#1e40af;font-size:.9rem;'>怎麼運作？</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>① 「詢問」會在舞台下方出現輸入框<br>② 使用者輸入後按 Enter<br>③ 輸入的內容存在「答案」裡<br>④ 把「答案」存到自己的變數<br><br>💡 為什麼要存到變數？因為下一次「詢問」時，「答案」就會被新內容蓋掉！</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 11, "title": "第二節 隨堂測驗", "chapter": "第二節：變數", "bg": "purple", "quiz": "q2", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>變數 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 12, "title": "運算積木", "chapter": "第三節：運算與循序結構", "bg": "white", "html": "<h2 class='slide-title'>➗ 運算積木：讓電腦幫你算</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:14%;'>運算</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:18%;'>數學符號</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:30%;'>Scratch 運算積木</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:38%;'>例子</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>加</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>＋</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>( ) + ( )</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>3 + 5 → 8</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>減</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>－</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>( ) - ( )</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>9 - 4 → 5</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>乘</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>×</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>( ) * ( )</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>6 * 7 → 42</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>除</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>÷</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>( ) / ( )</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>10 / 4 → 2.5</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 ⚠️ 電腦的乘號是 <strong>*</strong>（星號）、除號是 <strong>/</strong>（斜線），和數學課寫法不同。綠色運算積木是<strong>圓角</strong>的，要「放進」其他積木的空格裡使用。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 13, "title": "問題分析：求平均數", "chapter": "第三節：運算與循序結構", "bg": "white", "html": "<h2 class='slide-title'>🧮 範例：求 A 與 B 兩數的平均數</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>📥</div><strong style='color:#1e40af;font-size:.9rem;'>輸入</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>使用者輸入兩個數字<br>→ 存到變數 <strong>A</strong>、<strong>B</strong></div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>⚙️</div><strong style='color:#166534;font-size:.9rem;'>處理</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>平均 ＝ (A ＋ B) ÷ 2<br>→ 存到變數 <strong>平均</strong></div></div><div style='background:#f5f3ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>📤</div><strong style='color:#5b21b6;font-size:.9rem;'>輸出</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>角色說出平均數</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 📝 寫程式前先分析：需要<strong>幾個變數</strong>？分別存什麼？這就是第 6 週學的「輸入＋演算法＝輸出」。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 14, "title": "流程圖到程式", "chapter": "第三節：運算與循序結構", "bg": "white", "html": "<h2 class='slide-title'>🔀 從流程圖到 Scratch 程式</h2>\n<div style='display:grid;grid-template-columns:1fr 1.3fr;gap:12px;'><div style='display:flex;flex-direction:column;align-items:flex-start;gap:0;'><div style='display:flex;align-items:center;'><div style='width:210px;display:flex;justify-content:center;'><div style='border-radius:999px;background:#1e3a5f;color:#fff;width:150px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>開始</div></div></div><div style='width:210px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:210px;display:flex;justify-content:center;'><div style='clip-path:polygon(10% 0,100% 0,90% 100%,0 100%);background:#dcfce7;color:#14532d;width:150px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>輸入 A</div></div></div><div style='width:210px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:210px;display:flex;justify-content:center;'><div style='clip-path:polygon(10% 0,100% 0,90% 100%,0 100%);background:#dcfce7;color:#14532d;width:150px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>輸入 B</div></div></div><div style='width:210px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:210px;display:flex;justify-content:center;'><div style='border-radius:4px;background:#dbeafe;color:#1e3a8a;width:150px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>平均 ＝ (A＋B) ÷ 2</div></div></div><div style='width:210px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:210px;display:flex;justify-content:center;'><div style='clip-path:polygon(10% 0,100% 0,90% 100%,0 100%);background:#dcfce7;color:#14532d;width:150px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>輸出 平均</div></div></div><div style='width:210px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:210px;display:flex;justify-content:center;'><div style='border-radius:999px;background:#1e3a5f;color:#fff;width:150px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>結束</div></div></div></div>\n<div style='background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 14px;margin-bottom:10px;'><div style='font-size:.75rem;color:#64748b;margin-bottom:8px;'>每個流程圖符號，對應 1–2 個積木</div><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffbf00;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>當綠旗被點擊</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#5cb1d6;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>詢問 請輸入第一個數 並等待</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 A 設為 （答案）</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#5cb1d6;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>詢問 請輸入第二個數 並等待</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 B 設為 （答案）</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ff8c1a;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>變數 平均 設為 （(A + B) / 2）</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#9966ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>說出 字串組合 平均是 （平均） 持續 3 秒</span></div><br></div>\n</div>\n", "quiz": null, "chart": null, "video": null}, {"id": 15, "title": "循序結構的特色", "chapter": "第三節：運算與循序結構", "bg": "white", "html": "<h2 class='slide-title'>⬇️ 循序結構：順序決定結果</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>👍</div><strong style='color:#166534;font-size:.9rem;'>✅ 正確順序</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>詢問 A → 存 A → 詢問 B → 存 B → 計算 → 說出</div></div><div style='background:#fef2f2;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>👎</div><strong style='color:#991b1b;font-size:.9rem;'>❌ 順序錯了</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'><strong>先計算</strong>平均 → 再詢問 A、B<br>→ 計算時 A、B 還是空的（或上一次的值），結果錯誤！</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧠 循序結構「由上而下、每個積木執行一次」，所以<strong>先有資料，才能計算</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 16, "title": "第三節 隨堂測驗", "chapter": "第三節：運算與循序結構", "bg": "purple", "quiz": "q3", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>運算與循序結構 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 17, "title": "常見錯誤", "chapter": "第四節：除錯", "bg": "white", "html": "<h2 class='slide-title'>🐛 求平均數的 3 個常見錯誤</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:32%;'>錯誤</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:32%;'>結果</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:36%;'>怎麼修</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>寫成 A + (B / 2)</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>輸入 4、6 → 7（錯）</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>先加再除：(A + B) / 2 → 5</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>兩次「詢問」後才存變數</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>A 和 B 都變成第二次的答案</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>每次詢問完<strong>馬上</strong>存到變數</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>忘記接在「當綠旗被點擊」下面</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>按綠旗沒反應</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>把積木拖到帽子積木下方接好</td></tr></table>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧮 為什麼 A + (B / 2) 會錯？數學的「先乘除後加減」在電腦裡也成立！Scratch 是看<strong>積木怎麼套</strong>來決定先算哪個：把「+」積木放進「/」積木的左格，才是先加再除。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 18, "title": "除錯技巧", "chapter": "第四節：除錯", "bg": "white", "html": "<h2 class='slide-title'>🔧 除錯技巧：像偵探一樣找 bug</h2>\n<div style='display:flex;flex-direction:column;gap:8px;margin-bottom:12px;'><div style='display:flex;gap:12px;align-items:flex-start;background:#f5f3ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#7c3aed;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>1</div><div><strong style='color:#5b21b6;font-size:.88rem;'>勾選變數，顯示在舞台</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>執行時看變數的值有沒有照你想的變化</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f5f3ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#7c3aed;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>2</div><div><strong style='color:#5b21b6;font-size:.88rem;'>單獨點一下積木</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>在程式區直接點某個積木，只執行那一個，看看結果</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f5f3ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#7c3aed;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>3</div><div><strong style='color:#5b21b6;font-size:.88rem;'>一次只改一個地方</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>改完馬上測試，才知道是哪裡修好的</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#f5f3ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#7c3aed;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>4</div><div><strong style='color:#5b21b6;font-size:.88rem;'>用簡單的數字測試</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>例如輸入 4 和 6，心算平均是 5，比對程式結果</div></div></div></div>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 💬 寫程式的人都會遇到 bug，<strong>會除錯</strong>才是真正的高手。遇到問題先自己試 3 分鐘，再請同學或老師幫忙。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 19, "title": "第四節 隨堂測驗", "chapter": "第四節：除錯", "bg": "purple", "quiz": "q4", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第四節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>除錯 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 20, "title": "個人實作：循序結構程式", "chapter": "個人實作", "bg": "white", "html": "<h2 class='slide-title'>🐱 個人實作：用循序結構解決數學問題</h2>\n<div style='background:#eff6ff;border-radius:12px;padding:16px;margin-bottom:12px;'><p style='color:#1e40af;font-size:.9rem;font-weight:700;margin-bottom:8px;'>📋 先畫流程圖，再寫 Scratch 程式，分享連結到 Google 文件</p><div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#f8fafc;padding:14px;border-radius:10px;'><strong style='color:#334155;font-size:.9rem;'>必做：三角形面積</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>詢問底和高 → 面積 ＝ 底 × 高 ÷ 2 → 說出面積</div></div><div style='background:#f8fafc;padding:14px;border-radius:10px;'><strong style='color:#334155;font-size:.9rem;'>必做：學期成績</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>詢問作業、測驗、平時成績 → 學期成績 ＝ 作業×0.4 ＋ 測驗×0.4 ＋ 平時×0.2 → 說出</div></div><div style='background:#f8fafc;padding:14px;border-radius:10px;'><strong style='color:#334155;font-size:.9rem;'>挑戰：自創題</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>自己想一個需要 3 個以上變數的生活計算，例如「BMI」或「旅行預算」</div></div></div>\n</div><div style='background:#fffbeb;border-radius:10px;padding:14px;'><strong style='color:#92400e;font-size:.9rem;'>📏 評分（課程計畫：程式設計）</strong><p style='font-size:.78rem;color:#334155;margin-top:6px;line-height:1.8;'><strong style='color:#059669;'>A</strong> 能優化結構化（循序）程式，變數命名清楚並說明<br><strong style='color:#2563eb;'>B</strong> 能產出正確的循序結構程式<br><strong style='color:#d97706;'>C</strong> 能仿作循序結構程式<br><strong style='color:#dc2626;'>D</strong> 僅能部分完成循序結構程式</p></div>", "quiz": null, "chart": null, "video": null}, {"id": 21, "title": "本章重點回顧", "chapter": "個人實作", "bg": "navy", "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 第 12–13 週 重點回顧</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>事件積木</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>帽子形狀，放在最上方，決定程式何時開始</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>變數</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>貼了標籤的盒子；「設為」換掉內容、「改變」加上去</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>詢問與答案</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>詢問讓使用者輸入，答案要馬上存進變數</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>循序與除錯</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>由上而下執行，順序決定結果；用顯示變數、簡單數字來除錯</p></div></div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>同樣的積木要寫 100 次？一定有更好的方法！</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>下一週：Scratch 重複結構與學期總結</p>\n</div>\n", "quiz": null, "chart": null, "video": null}]