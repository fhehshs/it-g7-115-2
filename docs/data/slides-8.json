[{"id": 1, "title": "程式語言與結構化程式設計", "chapter": "封面", "bg": "navy", "html": "\n<div style='text-align:center;padding:24px 20px;'>\n  <div style='font-size:66px;margin-bottom:14px;'>💬</div>\n  <h1 style='font-size:2.6rem;font-weight:900;color:#fff;margin-bottom:10px;'>程式語言與結構化程式設計</h1>\n  <h2 style='font-size:1.25rem;font-weight:400;color:#93c5fd;margin-bottom:24px;'>Programming Languages · Structured Programming</h2>\n  <div style='display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;'><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>0️⃣1️⃣ 機器語言</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🐍 高階語言</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🔁 循序／選擇／重複</span><span style='background:rgba(255,255,255,0.15);color:#e0f2fe;padding:8px 18px;border-radius:20px;'>🐱 Scratch</span></div>\n  <p style='color:#bfdbfe;font-size:1.05rem;'>七年級第二學期 ｜ 第 10–11 週</p>\n</div>\n", "quiz": null, "chart": null, "video": null}, {"id": 2, "title": "程式是什麼？", "chapter": "第一節：程式是什麼", "bg": "white", "html": "<h2 class='slide-title'>💻 程式（Program）是什麼？</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #0d9488;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>📖 <strong>程式設計</strong>：依照邏輯順序，安排一組<strong>指令</strong>，讓電腦照著執行，實現演算法。</p></div>\n<div style='display:flex;flex-direction:column;gap:8px;margin-bottom:12px;'><div style='display:flex;gap:12px;align-items:flex-start;background:#eff6ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#2563eb;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>1</div><div><strong style='color:#1e40af;font-size:.88rem;'>想清楚問題</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>要解決什麼？輸入是什麼？要得到什麼輸出？</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#eff6ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#2563eb;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>2</div><div><strong style='color:#1e40af;font-size:.88rem;'>設計演算法</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>寫出步驟，或畫成流程圖（第 6–9 週學的）</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#eff6ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#2563eb;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>3</div><div><strong style='color:#1e40af;font-size:.88rem;'>寫成程式</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>用程式語言把步驟寫出來</div></div></div><div style='display:flex;gap:12px;align-items:flex-start;background:#eff6ff;border-radius:10px;padding:10px 14px;'><div style='width:28px;height:28px;border-radius:50%;background:#2563eb;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;'>4</div><div><strong style='color:#1e40af;font-size:.88rem;'>測試與除錯</strong><div style='font-size:.8rem;color:#475569;margin-top:3px;line-height:1.6;'>執行看看，結果不對就找出錯誤並修正</div></div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🐛 程式的錯誤叫做 <strong>bug（蟲）</strong>，找錯誤叫做 <strong>debug（除錯）</strong>。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 3, "title": "打孔卡與程式", "chapter": "第一節：程式是什麼", "bg": "white", "html": "<h2 class='slide-title'>🧵 程式的老祖先：提花織布機</h2>\n<div style='display:grid;grid-template-columns:1.2fr 1fr;gap:12px;'><div style='background:#fefce8;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🧵</div><strong style='color:#854d0e;font-size:.9rem;'>1804｜提花織布機</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>法國人<strong>雅卡爾</strong>發明用<strong>打孔卡片</strong>控制的織布機：卡片上的孔決定哪些線要提起，換一組卡片就織出不同花紋。</div></div><div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>💡</div><strong style='color:#1e40af;font-size:.9rem;'>兩個重要概念</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>① 複雜的設計，可以轉換成機器看得懂的「編碼」<br>② 機器可以照著編碼<strong>不斷重複工作</strong>，直到完成</div></div></div>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 🔗 串起來：提花織布機（1804）→ 何樂禮打孔卡（1890）→ 早期電腦程式也打在卡片上（第 1 週學過）。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 4, "title": "電腦只懂 0 和 1", "chapter": "第一節：程式是什麼", "bg": "white", "html": "<h2 class='slide-title'>🗣️ 電腦只懂 0 和 1，人要怎麼跟它溝通？</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🧑</div><strong style='color:#1e40af;font-size:.9rem;'>人類</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>說中文、英文，會猜意思、能接受模糊</div></div><div style='background:#fefce8;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🔄</div><strong style='color:#854d0e;font-size:.9rem;'>翻譯官</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>把程式語言翻譯成機器語言</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🖥️</div><strong style='color:#166534;font-size:.9rem;'>電腦</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>只懂 0 與 1，而且完全照字面執行</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧠 程式語言就是人和電腦之間的「共同語言」。越接近人類語言越好寫，但需要翻譯；越接近 0 與 1，電腦越直接懂。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 5, "title": "第一節 隨堂測驗", "chapter": "第一節：程式是什麼", "bg": "purple", "quiz": "q1", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第一節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>程式與程式設計 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 6, "title": "低階語言", "chapter": "第二節：程式語言的演進", "bg": "white", "html": "<h2 class='slide-title'>⚙️ 低階語言：機器語言與組合語言</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#fef2f2;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>0️⃣</div><strong style='color:#991b1b;font-size:.9rem;'>機器語言</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>由 <strong>0 與 1</strong> 組成，電腦可以直接執行。<br>例：<code>10110000 01100001</code><br>人很難看懂，不同 CPU 的機器語言也不同。</div></div><div style='background:#fff7ed;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🔤</div><strong style='color:#9a3412;font-size:.9rem;'>組合語言</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>用簡短的英文代號代替 0 與 1，需要「組譯」成機器語言。<br>例：<code>MOV AL, 61h</code>（把數值放進暫存器）<br>和 CPU 的硬體結構密切相關。</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 ⚡ 低階語言的優點：直接和 CPU 溝通、<strong>執行效率高</strong>；缺點：<strong>難寫、難懂、難移植</strong>到別種電腦。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 7, "title": "高階語言與翻譯", "chapter": "第二節：程式語言的演進", "bg": "white", "html": "<h2 class='slide-title'>🐍 高階語言：接近人類的語言</h2>\n<div style='background:#f1f5f9;border-radius:10px;padding:12px 16px;margin-bottom:14px;border-left:4px solid #2563eb;'><p style='margin:0;color:#0f172a;font-size:.93rem;line-height:1.7;'>📖 <strong>高階語言</strong>的語法接近英文和數學式，好學好讀；但要先<strong>翻譯</strong>成機器語言才能執行。</p></div>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#f5f3ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>📚</div><strong style='color:#5b21b6;font-size:.9rem;'>編譯（Compile）</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>像<strong>翻譯一整本書</strong>：全部翻好再拿去用。執行速度快。例：C 語言</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🎙️</div><strong style='color:#166534;font-size:.9rem;'>直譯（Interpret）</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>像<strong>現場口譯</strong>：翻一句、執行一句。方便測試修改。例：Python、JavaScript</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🌏 同一份高階語言程式，換到不同電腦，只要有對應的翻譯程式就能執行，比低階語言方便多了。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 8, "title": "常見的程式語言", "chapter": "第二節：程式語言的演進", "bg": "white", "html": "<h2 class='slide-title'>📚 常見的程式語言</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:18%;'>語言</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:16%;'>推出年份</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:66%;'>特色與用途</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>FORTRAN</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1957</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>IBM 推出，最早的高階語言之一，用於科學與工程計算</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>COBOL</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1959</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>商業資料處理，銀行、會計系統至今仍有使用</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>C</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1972</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>強大的一般用途語言，常用來寫作業系統</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>Python</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1991</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>語法簡潔、函式庫豐富，AI、資料分析很常用</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>Java</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1995</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>跨平台，Android App、企業系統</td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>JavaScript</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>1995</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>讓網頁「動起來」，現在也用在伺服器與遊戲</td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>Scratch</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>2007</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>MIT 開發的<strong>積木式</strong>語言，很適合入門</td></tr></table>\n", "quiz": null, "chart": null, "video": null}, {"id": 9, "title": "同一件事，不同語言", "chapter": "第二節：程式語言的演進", "bg": "white", "html": "<h2 class='slide-title'>👋 同一件事，不同語言：讓電腦說「Hello」</h2>\n<table style='width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0;margin-bottom:12px;'><tr style='background:#1E3A5F;color:#fff;'><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:24%;'>語言</th><th style='padding:9px 12px;text-align:left;font-size:.8rem;width:76%;'>程式碼</th></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>Python</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'><code>print(\"Hello\")</code></td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>JavaScript</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'><code>console.log(\"Hello\");</code></td></tr><tr style='background:#fff;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>C</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'><code>printf(\"Hello\");</code></td></tr><tr style='background:#f8fafc;'><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>Scratch</td><td style='padding:8px 12px;border-top:1px solid #e2e8f0;font-size:.8rem;color:#334155;vertical-align:top;line-height:1.6;'>拖出紫色積木「說出 Hello 持續 2 秒」</td></tr></table>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 🧠 語法不一樣，但<strong>背後的邏輯是一樣的</strong>。學會一種語言的思考方式，再學其他語言就快多了。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 10, "title": "第二節 隨堂測驗", "chapter": "第二節：程式語言的演進", "bg": "purple", "quiz": "q2", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第二節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>程式語言的演進 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 11, "title": "結構化程式設計", "chapter": "第三節：結構化程式設計", "bg": "teal", "html": "\n<div style='text-align:center;padding:12px 10px 4px;'>\n  <div style='font-size:48px;margin-bottom:8px;'>🧱</div>\n  <h2 style='font-size:1.6rem;font-weight:800;color:#fff;margin-bottom:6px;'>結構化程式設計</h2>\n  <p style='color:#ccfbf1;font-size:.95rem;margin-bottom:16px;'>只用三種結構組合出所有程式，方便閱讀、檢查和修改</p>\n</div>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;'><div style='background:rgba(255,255,255,.12);border-radius:10px;padding:12px 14px;'><strong style='color:#fff;font-size:.9rem;'>⬇️ 循序結構 Sequence</strong><p style='color:#ccfbf1;font-size:.8rem;margin-top:5px;line-height:1.7;'>由上而下，一步接一步</p></div><div style='background:rgba(255,255,255,.12);border-radius:10px;padding:12px 14px;'><strong style='color:#fff;font-size:.9rem;'>🔀 選擇結構 Selection</strong><p style='color:#ccfbf1;font-size:.8rem;margin-top:5px;line-height:1.7;'>依條件判斷，決定做哪一段</p></div><div style='background:rgba(255,255,255,.12);border-radius:10px;padding:12px 14px;'><strong style='color:#fff;font-size:.9rem;'>🔁 重複結構 Repetition</strong><p style='color:#ccfbf1;font-size:.8rem;margin-top:5px;line-height:1.7;'>讓某些指令重複執行</p></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 12, "title": "循序結構", "chapter": "第三節：結構化程式設計", "bg": "white", "html": "<h2 class='slide-title'>⬇️ 循序結構：一步接一步</h2>\n<div style='display:grid;grid-template-columns:1fr 1.2fr;gap:12px;'><div style='display:flex;flex-direction:column;align-items:flex-start;gap:0;'><div style='display:flex;align-items:center;'><div style='width:210px;display:flex;justify-content:center;'><div style='border-radius:999px;background:#1e3a5f;color:#fff;width:150px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>開始</div></div></div><div style='width:210px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:210px;display:flex;justify-content:center;'><div style='border-radius:4px;background:#dbeafe;color:#1e3a8a;width:150px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>擠牙膏</div></div></div><div style='width:210px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:210px;display:flex;justify-content:center;'><div style='border-radius:4px;background:#dbeafe;color:#1e3a8a;width:150px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>刷牙 2 分鐘</div></div></div><div style='width:210px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:210px;display:flex;justify-content:center;'><div style='border-radius:4px;background:#dbeafe;color:#1e3a8a;width:150px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>漱口</div></div></div><div style='width:210px;text-align:center;color:#64748b;font-size:.95rem;line-height:1.3;'>↓</div><div style='display:flex;align-items:center;'><div style='width:210px;display:flex;justify-content:center;'><div style='border-radius:999px;background:#1e3a5f;color:#fff;width:150px;padding:9px 14px;text-align:center;font-size:.8rem;font-weight:600;line-height:1.4;'>結束</div></div></div></div>\n<div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>⬇️</div><strong style='color:#1e40af;font-size:.9rem;'>特色</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>🔹 最基本的結構<br>🔹 指令<strong>由上而下</strong>依序執行<br>🔹 每個指令都會被執行，而且只執行一次<br><br>⚠️ 順序很重要：先漱口再擠牙膏，結果就不一樣了！</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 13, "title": "選擇結構", "chapter": "第三節：結構化程式設計", "bg": "white", "html": "<h2 class='slide-title'>🔀 選擇結構：依條件走不同的路</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#fefce8;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>☂️</div><strong style='color:#854d0e;font-size:.9rem;'>單向選擇</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'><strong>如果</strong>下雨，<strong>就</strong>帶傘。<br>（沒下雨就什麼都不做，直接出門）</div></div><div style='background:#f5f3ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>📝</div><strong style='color:#5b21b6;font-size:.9rem;'>雙向選擇</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'><strong>如果</strong>分數 ≥ 60，顯示「及格」；<strong>否則</strong>顯示「不及格」。<br>（兩條路一定會走其中一條）</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🔗 第 5 週試算表的 <strong>IF 函數</strong>就是雙向選擇！條件成立稱為 <strong>True（真）</strong>，不成立稱為 <strong>False（假）</strong>。<br>📌 選擇結構會在第三學期用 Scratch 深入練習。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 14, "title": "重複結構", "chapter": "第三節：結構化程式設計", "bg": "white", "html": "<h2 class='slide-title'>🔁 重複結構：讓電腦做重複的事</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🔢</div><strong style='color:#1e40af;font-size:.9rem;'>計次式迴圈</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'><strong>知道要重複幾次</strong>。<br>例：跳繩跳 100 下、繞操場跑 3 圈</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>⏰</div><strong style='color:#166534;font-size:.9rem;'>條件式迴圈</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'><strong>不知道幾次，但知道什麼時候停</strong>。<br>例：一直跑，跑到鐘聲響為止</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🤖 電腦最擅長重複：重複 1 萬次也不會累、不會出錯。寫程式時，看到「一樣的事做很多次」就該想到迴圈。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 15, "title": "第三節 隨堂測驗", "chapter": "第三節：結構化程式設計", "bg": "purple", "quiz": "q3", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第三節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>三種結構 ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 16, "title": "Scratch 是什麼？", "chapter": "第四節：認識 Scratch", "bg": "white", "html": "<h2 class='slide-title'>🐱 Scratch：用積木寫程式</h2>\n<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px;'><div style='background:#fff7ed;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🧩</div><strong style='color:#9a3412;font-size:.9rem;'>積木式</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>不用打字，把積木<strong>拖曳、拼接</strong>起來就是程式，不會有拼字錯誤</div></div><div style='background:#eff6ff;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🌐</div><strong style='color:#1e40af;font-size:.9rem;'>免費、線上</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>MIT 媒體實驗室開發，用瀏覽器開啟 scratch.mit.edu 就能使用，也有離線版</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;text-align:center;'><div style='font-size:1.8rem;'>🎮</div><strong style='color:#166534;font-size:.9rem;'>做什麼都行</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>動畫、遊戲、互動故事、音樂……全世界有大量作品可以觀摩</div></div></div>\n<div style='background:#eff6ff;padding:11px 16px;border-radius:8px;border-left:4px solid #2563eb;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'>💬 🧠 積木的形狀會「卡」在一起：形狀不合的積木拼不上去，可以避免很多語法錯誤。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 17, "title": "Scratch 介面導覽", "chapter": "第四節：認識 Scratch", "bg": "white", "html": "<h2 class='slide-title'>🗺️ Scratch 介面導覽</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🧱</div><strong style='color:#1e40af;font-size:.9rem;'>① 積木區（左）</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>依顏色分類：動作（藍）、外觀（紫）、音效（粉紅）、事件（黃）、控制（橘黃）、偵測（淺藍）、運算（綠）、變數（橘）</div></div><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>📝</div><strong style='color:#166534;font-size:.9rem;'>② 程式區（中）</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>把積木拖到這裡組合成程式；右鍵可以「清理積木」排整齊</div></div><div style='background:#fefce8;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🎭</div><strong style='color:#854d0e;font-size:.9rem;'>③ 舞台（右上）</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>程式執行的地方；左上角的<strong>綠旗</strong>開始、<strong>紅色停止鈕</strong>結束</div></div><div style='background:#f5f3ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>🐱</div><strong style='color:#5b21b6;font-size:.9rem;'>④ 角色區（右下）</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>新增、選擇角色與背景；每個角色可以有自己的程式</div></div></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 18, "title": "使用 Scratch 的好習慣", "chapter": "第四節：認識 Scratch", "bg": "white", "html": "<h2 class='slide-title'>🛡️ 使用 Scratch 的好習慣</h2>\n<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;'><div style='background:#f0fdf4;padding:14px;border-radius:10px;'><strong style='color:#166534;font-size:.9rem;'>✅ 要這樣做</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>🔹 帳號名稱<strong>不要用真實姓名</strong><br>🔹 作品常常按「儲存」或下載到電腦<br>🔹 改編別人的作品，要在說明中<strong>註明原作者</strong>（Scratch 會自動標示改編來源）</div></div><div style='background:#fef2f2;padding:14px;border-radius:10px;'><strong style='color:#991b1b;font-size:.9rem;'>❌ 不要這樣做</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>🔹 在作品或留言中公開學校、電話、住址<br>🔹 直接複製別人作品當成自己的作業<br>🔹 留言攻擊或嘲笑別人的作品</div></div></div>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 🔗 和上學期的<strong>個資保護</strong>與<strong>創用 CC</strong> 是一樣的道理：Scratch 社群分享的作品預設採用 CC BY-SA 授權。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 19, "title": "第四節 隨堂測驗", "chapter": "第四節：認識 Scratch", "bg": "purple", "quiz": "q4", "html": "\n<div style='text-align:center;padding:44px 20px;'>\n  <div style='font-size:54px;margin-bottom:16px;'>📝</div>\n  <h1 style='font-size:2rem;color:#fff;margin-bottom:10px;'>第四節 隨堂測驗</h1>\n  <p style='color:#e9d5ff;font-size:1rem;'>認識 Scratch ｜ 3 題</p>\n  <p style='color:#c4b5fd;font-size:.85rem;margin-top:18px;'>按「下一頁 →」開始作答</p>\n</div>\n", "chart": null, "video": null}, {"id": 20, "title": "個人實作：我的第一支 Scratch 程式", "chapter": "個人實作", "bg": "white", "html": "<h2 class='slide-title'>🐱 個人實作：我的第一支 Scratch 程式</h2>\n<div style='display:grid;grid-template-columns:1fr 1.2fr;gap:12px;'><div style='background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 14px;margin-bottom:10px;'><div style='font-size:.75rem;color:#64748b;margin-bottom:8px;'>範例程式（可以自己改編）</div><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffbf00;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>當綠旗被點擊</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#9966ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>說出 嗨！我是〇〇 持續 2 秒</span></div><br><div style='margin-left:0px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffab19;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>重複 10 次</span></div><br><div style='margin-left:22px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#4c97ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>移動 10 點</span></div><br><div style='margin-left:22px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#9966ff;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>換成下一個造型</span></div><br><div style='margin-left:22px;margin-bottom:4px;display:inline-block;width:auto;'><span style='display:inline-block;background:#ffab19;color:#fff;border-radius:6px;padding:5px 12px;font-size:.8rem;font-weight:600;'>等待 0.2 秒</span></div><br></div>\n<div><div style='background:#eff6ff;padding:14px;border-radius:10px;'><div style='font-size:1.8rem;'>📋</div><strong style='color:#1e40af;font-size:.9rem;'>任務</strong><div style='font-size:.8rem;color:#475569;margin-top:6px;line-height:1.7;'>① 照範例拼出程式，按綠旗執行<br>② 改變說話內容與移動距離<br>③ 換一個角色和背景<br>④ 在 Google 文件寫下：這支程式用了哪些<strong>結構</strong>？</div></div><div style='height:10px'></div><div style='background:#fffbeb;border-radius:10px;padding:14px;'><strong style='color:#92400e;font-size:.9rem;'>📏 評分（課程計畫：程式設計）</strong><p style='font-size:.78rem;color:#334155;margin-top:6px;line-height:1.8;'><strong style='color:#059669;'>A</strong> 能說明程式中的循序與重複結構，並有自己的創意改編<br><strong style='color:#2563eb;'>B</strong> 完成程式並正確執行<br><strong style='color:#d97706;'>C</strong> 能仿照範例完成程式<br><strong style='color:#dc2626;'>D</strong> 僅完成部分程式</p></div></div></div>\n<div style='background:#fefce8;padding:11px 16px;border-radius:8px;border-left:4px solid #f59e0b;'><p style='color:#374151;font-size:.88rem;margin:0;line-height:1.7;'> 🎨 範例積木的顏色和 Scratch 一樣：黃＝事件、紫＝外觀、橘黃＝控制、藍＝動作。往右縮排的積木，代表放在「重複」裡面。</p></div>\n", "quiz": null, "chart": null, "video": null}, {"id": 21, "title": "本章重點回顧", "chapter": "個人實作", "bg": "navy", "html": "\n<h2 style='color:#fff;font-size:1.5rem;font-weight:700;margin-bottom:14px;'>📌 第 10–11 週 重點回顧</h2>\n<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;'><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>程式設計</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>依邏輯順序安排指令；流程：分析 → 演算法 → 寫程式 → 除錯</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>程式語言</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>機器語言（0/1）→ 組合語言 → 高階語言；高階語言需編譯或直譯</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>三種結構</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>循序（一步接一步）、選擇（依條件）、重複（計次式／條件式）</p></div><div style='background:rgba(255,255,255,.1);border-radius:10px;padding:13px;'><strong style='color:#93c5fd;font-size:.9rem;'>Scratch</strong><p style='color:#e2e8f0;font-size:.8rem;margin-top:5px;line-height:1.7;'>MIT 積木式語言；積木區、程式區、舞台、角色區</p></div></div>\n<div style='background:linear-gradient(90deg,rgba(13,148,136,.35),rgba(107,63,160,.35));border-radius:10px;padding:16px 20px;text-align:center;'>\n  <p style='color:#fff;font-size:1.02rem;font-weight:700;margin:0;'>程式要怎麼「記住」使用者輸入的數字？</p>\n  <p style='color:#cbd5e1;font-size:.82rem;margin-top:6px;'>下一週：Scratch 入門——變數與循序結構</p>\n</div>\n", "quiz": null, "chart": null, "video": null}]